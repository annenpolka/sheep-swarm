{
  "name": "sheep-swarm",
  "version": "0.0.0",
  "private": true,
  "description": "Experimental artifact-local swarm with Luna workers and selective metamanagement",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "demo": "node experiments/demo.ts",
    "check:references": "node scripts/check-references.mjs",
    "check": "npm run typecheck && npm test && npm run check:references",
    "swarm": "node src/cli.ts",
    "durable": "node src/durable-cli.ts",
    "compare": "node src/compare-cli.ts",
    "estimate:cost": "node scripts/estimate-costs.mjs"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "7.0.2"
  }
}
