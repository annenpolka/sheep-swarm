{
  "name": "sheep-swarm",
  "version": "0.0.0",
  "private": true,
  "description": "Experimental artifact-local swarm with Luna workers and selective metamanagement",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "demo": "node experiments/demo.ts",
    "check:references": "node scripts/check-references.mjs",
    "check": "npm run typecheck && npm test && npm run check:references",
    "swarm": "node src/cli.ts",
    "repo": "node src/repo-cli.ts",
    "durable": "node src/durable-cli.ts",
    "compare": "node src/compare-cli.ts",
    "estimate:cost": "node scripts/estimate-costs.mjs",
    "mechanism": "node src/mechanism-cli.ts",
    "mechanism:experiment": "node scripts/mechanism-experiment.mjs",
    "sandbox:install": "node scripts/install-docker-agent.mjs",
    "sandbox:probe": "node scripts/probe-docker-sandbox.mjs",
    "sandbox:pilot": "node src/docker-agent-pilot.ts",
    "sandbox:swarm-probe": "node scripts/probe-docker-swarm.mjs",
    "sandbox:reap": "node scripts/reap-docker-sandboxes.mjs",
    "sandbox:recovery-probe": "node scripts/probe-docker-recovery.mjs",
    "sandbox:comparison-probe": "node scripts/probe-docker-comparison.mjs",
    "sandbox:mechanism-probe": "node scripts/probe-docker-mechanism.mjs",
    "sandbox:completion-probe": "node scripts/probe-docker-completion.mjs",
    "swarm:diagnostics": "node scripts/swarm-docker-diagnostics.mjs",
    "summarize:docker-mechanism": "node scripts/summarize-docker-mechanism.mjs",
    "sheep": "node src/sheep-cli.ts"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "7.0.2"
  }
}
